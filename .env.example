SECRET_KEY=your-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.0,*

# CSRF Trusted Origins (comma-separated URLs, required for admin login in production)
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# AI Backend Service URL (defaults to ngrok if not set)
# AI_SERVICE_URL=https://question-generation-system-production-eb64.up.railway.app

# Database Configuration (for Docker)
DATABASE_NAME=gradproject
DATABASE_USER=graduser
DATABASE_PASSWORD=gradpassword

# Optional: Set DATABASE_URL if not using Docker compose default
# DATABASE_URL=postgres://graduser:gradpassword@db:5432/gradproject
